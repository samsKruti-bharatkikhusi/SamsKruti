# ─────────────────────────────────────────────────────────────
# SamsKruti — environment template. Copy the DB lines into `.env`
# (which is gitignored) and fill in your Supabase values.
# ─────────────────────────────────────────────────────────────

# Supabase Postgres — TWO urls are required by Prisma:
#
#   DATABASE_URL  → pooled connection (Supavisor), port 6543. The app uses this
#                   at runtime. Must end with ?pgbouncer=true.
#   DIRECT_URL    → direct connection, port 5432. `prisma migrate` uses this.
#
# Get both from Supabase dashboard → Project → Connect → ORMs → Prisma.
# Replace [PROJECT-REF], [PASSWORD], and [REGION] with your project's values.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Client-side (already in .env.local)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...
